-- Basic Options
vim.opt.ignorecase = true
vim.opt.smartcase = true
vim.opt.incsearch = true
vim.opt.hlsearch = true
vim.opt.scrolloff = 10
vim.opt.number = true
vim.opt.relativenumber = true
vim.opt.showcmd = true
vim.opt.showmatch = true
vim.opt.ruler = true
vim.opt.smarttab = true
vim.opt.softtabstop = 0
vim.opt.expandtab = false
vim.opt.shiftwidth = 4
vim.opt.tabstop = 4
vim.opt.hidden = true
vim.opt.termguicolors = true
vim.opt.clipboard:append({ "unnamed", "unnamedplus" })

-- Syntax Highlighting (normally on by default in Lua)
vim.cmd("syntax on")

-- Leader Key
vim.g.mapleader = " "

-- Keymaps
local keymap = vim.keymap.set
local opts = { noremap = true, silent = true }

-- Insert mode: jk to escape
keymap("i", "jk", "<Esc>", { noremap = true, nowait = true })

-- Visual mode: Easy tab indent
keymap("v", "<", "<gv", opts)
keymap("v", ">", ">gv", opts)

-- Nicer join with cursor restore
keymap("n", "J", "mzJ`z", opts)

-- Ex mode (file explorer)
keymap("n", "<leader>p", ":Ex<CR>", opts)

-- Move lines (control + j/k)
keymap("v", "<C-j>", ":m '>+1<CR>gv=gv", opts)
keymap("n", "<C-j>", ":m .+1<CR>==", opts)
keymap("n", "<C-k>", ":m .-2<CR>==", opts)
keymap("v", "<C-k>", ":m '<-2<CR>gv=gv", opts)

-- Center screen on movement
keymap("n", "<C-d>", "<C-d>zz", opts)
keymap("n", "<C-u>", "<C-u>zz", opts)
keymap("n", "n", "nzzzv", opts)
keymap("n", "N", "Nzzzv", opts)

-- Toggle relative line numbers
keymap("n", "<leader>rl", ":set rnu!<CR>", opts)

-- Delete without yanking
keymap("n", "<leader>d", "\"_d", opts)
keymap("v", "<leader>d", "\"_d", opts)

-- Replace selection without yanking
keymap("v", "<leader>p", "\"_dP", opts)

-- Buffer navigation
keymap("n", "<leader>b", ":buffers<CR>:buffer ", { noremap = true })
keymap("n", "<C-h>", ":bp<CR>", opts)
keymap("n", "<C-l>", ":bn<CR>", opts)

-- Macro mappings
keymap("n", "<leader>.", "@@", opts)
keymap("n", "Q", "@q", opts)

-- Custom statusline
vim.opt.statusline = ""
vim.opt.statusline:append(" %F %M %Y %R")
vim.opt.statusline:append("%=")
vim.opt.statusline:append(" ascii: %b hex: 0x%B row: %l col: %c percent: %p%%")
vim.opt.laststatus = 2
